{
    "bash": {
        "requires_approval_if_contains": [
            "rm",
            "mv",
            "sudo"
        ]
    },
    "edge_device": {
        "requires_approval_if_match": {
            "operation": "dispatch_task"
        }
    },
    "file_operations": {
        "requires_approval_if_match": {
            "operation": "delete"
        }
    }
}
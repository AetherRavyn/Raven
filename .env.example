# ═══════════════════════════════════════════════════════════════════════════════
# SARAS — Complete Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy to .env and fill in your values:  cp .env.example .env

# ─── API KEYS ─────────────────────────────────────────────────────────────────

# Gemini / Google Generative AI (primary LLM + web search grounding)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# xAI (Grok)
XAI_API_KEY=
XAI_MANAGEMENT_API_KEY=

# Killo (multi-model gateway)
KILLO_API_KEY=

# Perplexity (AI search)
PERPLEXITY_API_KEY=

# OpenRouter (multi-provider gateway)
OPENROUTER_API_KEY=

# Brave Search (structured web/news/image search)
BRAVE_API_KEY=

# Firecrawl (web scraping)
FIRECRAWL_API_KEY=

# Twitter/X (API v2)
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# Reddit (PRAW)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# YouTube (Data API v3)
YOUTUBE_API_KEY=

# VirusTotal (malware/URL scanning)
VIRUSTOTAL_API_KEY=

# Wolfram Alpha (computational knowledge — free 2000 calls/month)
WOLFRAM_ALPHA_APP_ID=

# OpenWeatherMap (free tier — https://openweathermap.org/api)
OPENWEATHERMAP_API_KEY=

# WAQI (Air Quality Index — https://aqicn.org/data-platform/token/)
WAQI_API_KEY=

# Deepgram (speech-to-text)
DEEPGRAM_API_KEY=

# SpeechMate
API_KEY_SPEECHMATE=

# Notion (Internal Integration Token — https://www.notion.so/my-integrations)
NOTION_API_KEY=

# Todoist (task management)
TODOIST_API_TOKEN=

# GitHub (personal access token — for GitHubTool)
GITHUB_TOKEN=

# Supabase (hosted Postgres + auth)
SUPABASE_URL=
SUPABASE_KEY=

# ─── PLATFORM TOKENS ─────────────────────────────────────────────────────────

# Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=

# Discord Bot Token (from Discord Developer Portal)
DISCORD_BOT_TOKEN=

# Default Discord channel used by SARAS
DISCORD_CHANNEL_ID=

# Optional: set true only if Message Content Intent is enabled in Discord portal
DISCORD_ENABLE_MESSAGE_CONTENT_INTENT=true

# Slack (Socket Mode — requires both tokens)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# WhatsApp (Baileys bridge)
WHATSAPP_BRIDGE_URL=

# ─── GOOGLE SERVICES (OAuth) ─────────────────────────────────────────────────

# Gmail OAuth
GMAIL_CREDENTIALS_PATH=workspace/gmail_credentials.json

# Google Calendar OAuth
GOOGLE_CALENDAR_CREDENTIALS_PATH=workspace/google_calendar_credentials.json
GOOGLE_CALENDAR_TOKEN_PATH=workspace/calendar_token.json

# ─── SMART HOME / IoT ────────────────────────────────────────────────────────

# Home Assistant
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=

# MQTT broker
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ─── MUSIC / MEDIA ───────────────────────────────────────────────────────────

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Obsidian vault path
OBSIDIAN_VAULT_PATH=/path/to/vault

# ─── EMAIL (SMTP) ────────────────────────────────────────────────────────────

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── LOCAL / SELF-HOSTED SERVICES ────────────────────────────────────────────

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# SearXNG (self-hosted private search)
SEARXNG_URL=http://localhost:8080

# ─── INFRASTRUCTURE ──────────────────────────────────────────────────────────

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://saras:saras@localhost/saras

# Redis
REDIS_URL=redis://localhost:6379

# Memory backend ("chroma" or "pgvector")
MEMORY_BACKEND=chroma

# ─── DASHBOARDS ──────────────────────────────────────────────────────────────

# Web dashboard (FastAPI — chat interface)
WEB_DASHBOARD_ENABLED=false
WEB_DASHBOARD_PORT=8090
WEB_DASHBOARD_HOST=0.0.0.0

# Streamlit admin dashboard (config, agents, models, memory)
STREAMLIT_DASHBOARD_ENABLED=false
STREAMLIT_DASHBOARD_PORT=8501
STREAMLIT_DASHBOARD_HOST=0.0.0.0

# ─── SCHEDULING / ROUTINES ───────────────────────────────────────────────────

# Morning briefing — comma-separated "platform:user_id:chat_id" entries
MORNING_BRIEFING_USERS=
MORNING_BRIEFING_HOUR=8
MORNING_BRIEFING_MINUTE=0

# Default location for weather/commute
DEFAULT_LOCATION=London

# ─── MONITORING (separate subsystem) ─────────────────────────────────────────

# Telegram (monitoring alerts — separate from main bot)
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=

# Frigate NVR
# FRIGATE_API_URL=http://localhost:5000
# ANOMALY_WEBHOOK_URL=

# Have I Been Pwned (breach check)
HIBP_API_KEY=

# ─── ADMIN ────────────────────────────────────────────────────────────────────

# Admin user IDs (comma-separated)
ADMIN_USER_IDS=

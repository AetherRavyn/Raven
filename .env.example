# ═══════════════════════════════════════════════════════════════════════════════
# Raven — Complete Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy to .env and fill in your values:  cp .env.example .env

# ─── API KEYS ─────────────────────────────────────────────────────────────────

# Gemini / Google Generative AI (primary LLM + web search grounding)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# xAI (Grok)
XAI_API_KEY=
XAI_MANAGEMENT_API_KEY=

# Killo (multi-model gateway)
KILLO_API_KEY=

# OpenCode Zen (free gateway — 5 models, no key needed)
# Models: big-pickle, deepseek-v4-flash-free, mimo-v2.5-free, qwen3.6-plus-free, nemotron-3-super-free
# Base URL: https://opencode.ai/zen/v1
OPENCODE_ZEN_API_KEY=no-key-needed
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_MODEL=big-pickle

# Perplexity (AI search)
PERPLEXITY_API_KEY=

# OpenRouter (multi-provider gateway)
OPENROUTER_API_KEY=

# Brave Search (structured web/news/image search)
BRAVE_API_KEY=

# Firecrawl (web scraping)
FIRECRAWL_API_KEY=

# Twitter/X (API v2)
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# Reddit (PRAW)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# YouTube (Data API v3)
YOUTUBE_API_KEY=

# VirusTotal (malware/URL scanning)
VIRUSTOTAL_API_KEY=

# Wolfram Alpha (computational knowledge — free 2000 calls/month)
WOLFRAM_ALPHA_APP_ID=

# OpenWeatherMap (free tier — https://openweathermap.org/api)
OPENWEATHERMAP_API_KEY=

# WAQI (Air Quality Index — https://aqicn.org/data-platform/token/)
WAQI_API_KEY=

# Deepgram (speech-to-text)
DEEPGRAM_API_KEY=

# SpeechMate
API_KEY_SPEECHMATE=

# Notion (Internal Integration Token — https://www.notion.so/my-integrations)
NOTION_API_KEY=

# Todoist (task management)
TODOIST_API_TOKEN=

# GitHub (personal access token — for GitHubTool)
GITHUB_TOKEN=

# Supabase (hosted Postgres + auth)
SUPABASE_URL=
SUPABASE_KEY=

# ─── PLATFORM TOKENS ─────────────────────────────────────────────────────────

# Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=

# Discord Bot Token (from Discord Developer Portal)
DISCORD_BOT_TOKEN=

# Default Discord channel used by Raven
DISCORD_CHANNEL_ID=

# Optional: set true only if Message Content Intent is enabled in Discord portal
DISCORD_ENABLE_MESSAGE_CONTENT_INTENT=true

# Slack (Socket Mode — requires both tokens)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# WhatsApp (Baileys bridge)
WHATSAPP_BRIDGE_URL=

# ─── GOOGLE SERVICES (OAuth) ─────────────────────────────────────────────────

# Gmail OAuth
GMAIL_CREDENTIALS_PATH=workspace/gmail_credentials.json

# Google Calendar OAuth
GOOGLE_CALENDAR_CREDENTIALS_PATH=workspace/google_calendar_credentials.json
GOOGLE_CALENDAR_TOKEN_PATH=workspace/calendar_token.json

# ─── SMART HOME / IoT ────────────────────────────────────────────────────────

# Home Assistant
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=

# MQTT broker
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ─── MUSIC / MEDIA ───────────────────────────────────────────────────────────

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Obsidian vault path
OBSIDIAN_VAULT_PATH=/path/to/vault

# ─── EMAIL (SMTP) ────────────────────────────────────────────────────────────

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── LOCAL / SELF-HOSTED SERVICES ────────────────────────────────────────────

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# SearXNG (self-hosted private search)
SEARXNG_URL=http://localhost:8080

# ─── INFRASTRUCTURE ──────────────────────────────────────────────────────────

# Memory backend: helix (default) — HelixDB + SQLite only
MEMORY_BACKEND=helix

# ─── DASHBOARDS ──────────────────────────────────────────────────────────────

# Web dashboard (FastAPI — chat interface)
WEB_DASHBOARD_ENABLED=false
WEB_DASHBOARD_PORT=8090
WEB_DASHBOARD_HOST=0.0.0.0

# Streamlit admin dashboard (config, agents, models, memory)
STREAMLIT_DASHBOARD_ENABLED=false
STREAMLIT_DASHBOARD_PORT=8501
STREAMLIT_DASHBOARD_HOST=0.0.0.0

# ─── SCHEDULING / ROUTINES ───────────────────────────────────────────────────

# Morning briefing — comma-separated "platform:user_id:chat_id" entries
MORNING_BRIEFING_USERS=
MORNING_BRIEFING_HOUR=8
MORNING_BRIEFING_MINUTE=0

# Default location for weather/commute
DEFAULT_LOCATION=London

# ─── MONITORING (separate subsystem) ─────────────────────────────────────────

# Telegram (monitoring alerts — separate from main bot)
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=

# Frigate NVR
# FRIGATE_API_URL=http://localhost:5000
# ANOMALY_WEBHOOK_URL=

# Have I Been Pwned (breach check)
HIBP_API_KEY=

# ─── ADMIN ────────────────────────────────────────────────────────────────────

# Admin user IDs (comma-separated)
ADMIN_USER_IDS=

# ─── VOICE (v33 — whisper.cpp STT + Piper-TTS autherRaven) ───────────────────

# Toggle the on-device mic pipeline (wake-word → STT → TTS loop).
# Set to "true" to enable the local voice assistant.
ENABLE_LOCAL_VOICE=false

# Per-user TTS voice customization: "user_id:voice_name,user_id2:voice_name2"
# Each voice_name is a path to a Piper .onnx file.  Default is autherRaven.
VOICE_TTS_VOICES=

# Legacy env var: was the BCP-47 edge-tts voice name in v32 and earlier.
# In v33 it's deprecated — set to a .onnx path to override, or leave empty
# to use PIPER_VOICE_MODEL.  BCP-47 strings emit a one-time DeprecationWarning.
VOICE_TTS_VOICE=

# ── Whisper.cpp (replaces faster-whisper, v33) ──────────────────────────────
# Path to the ggml model file.  Download ggml-tiny.bin (~75 MB) on first use.
WHISPER_CPP_MODEL=workspace/models/whisper/ggml-tiny.bin

# Force the loader to fail fast if the model is missing instead of
# silently falling through to Vosk.  Set to "true" in production for
# louder errors; leave "false" in dev for graceful degradation.
WHISPER_CPP_OFFLINE=false

# Language hint passed to the whisper.cpp engine.  "en" by default;
# "auto" lets the engine detect.
WHISPER_CPP_LANGUAGE=en

# CPU threads for the C++ inference loop.  2 is the default; raise to
# 4 on a multi-core host for faster wake-word response.
WHISPER_CPP_THREADS=2

# ── Piper-TTS (replaces edge-tts, v33 — autherRaven personality) ────────────
# Path to the Piper voice model.  The on-disk en_US-lessac-medium.onnx
# is Raven's "autherRaven" voice — natural, local, no cloud round-trip.
PIPER_VOICE_MODEL=app/voice/en_US-lessac-medium.onnx
PIPER_VOICE_CONFIG=app/voice/en_US-lessac-medium.onnx.json

# Personality name exposed via /api/voice/config and rendered in the
# dashboard chat header.  Default: "autherRaven".
PIPER_VOICE_NAME=autherRaven

# ── Browser voice output (v33 — fan-out via SinkRegistry) ──────────────────
# Set to "true" to serve TTS audio to the dashboard browser over
# WS /voice/{user_id}.  The local sound card still plays; the browser
# plays in parallel.
ENABLE_BROWSER_VOICE=true

# Wake-word detection threshold (openwakeword, 0.0-1.0).  0.5 is
# the empirical default; raise to 0.7 for noisy environments.
VOICE_WAKE_WORD_THRESHOLD=0.5

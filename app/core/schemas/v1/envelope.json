{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RAVEN Envelope Schema v1",
  "type": "object",
  "required": ["header", "body"],
  "additionalProperties": true,
  "properties": {
    "header": {
      "type": "object",
      "required": ["schema", "kind", "timestamp", "correlation_id", "source"],
      "properties": {
        "schema": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "chat",
            "tool_call",
            "tool_result",
            "alert",
            "metric",
            "life_event",
            "plan_step",
            "audit",
            "health"
          ]
        },
        "timestamp": { "type": "string" },
        "correlation_id": { "type": "string" },
        "causation_id": { "type": "string" },
        "source": { "type": "string" },
        "idempotency_key": { "type": "string" }
      }
    },
    "body": { "type": "object" },
    "signature": { "type": "string" },
    "signer_pubkey": { "type": "string" }
  }
}
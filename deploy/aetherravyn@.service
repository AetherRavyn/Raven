[Unit]
Description=Raven Gateway Daemon (template)
Documentation=https://github.com/swadhinbiswas/Raven
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/SARAS
ExecStart=/home/%i/SARAS/scripts/raven-daemon.sh --daemon
Restart=always
RestartSec=5
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=raven

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/%i/SARAS /tmp
PrivateTmp=yes

# Resource limits
MemoryMax=2G
CPUQuota=200%

[Install]
WantedBy=multi-user.target

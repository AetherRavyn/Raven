{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "RAVEN — nightly eval trend + runtime metrics.  Auto-provisioned by monitoring/grafana/provisioning/dashboards/raven.yml.  Edit the JSON in this repo; do not edit the provisioned dashboard via the Grafana UI (changes will be lost on container restart).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "uid": "raven-overview",
  "title": "RAVEN — overview",
  "tags": ["raven", "eval", "observability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "weekStart": "",
  "refresh": "5m",
  "time": {"from": "now-7d", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {"selected": false, "text": "Prometheus", "value": "Prometheus"},
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Latest eval — pass rate",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 0.85},
              {"color": "green", "value": 0.95}
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "raven_eval_pass_rate",
          "legendFormat": "pass rate"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Regression verdict (last run)",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"options": {"0": {"text": "FAIL", "color": "red"}}, "type": "value"},
            {"options": {"1": {"text": "PASS", "color": "green"}}, "type": "value"}
          ]
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "raven_eval_regression_verdict",
          "legendFormat": "verdict"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latest eval — p95 latency",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "ms"}},
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "raven_eval_p95_latency_ms",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Latest eval — total cost",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}},
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "raven_eval_total_cost_usd",
          "legendFormat": "cost"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Reports in retention window",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "raven_eval_reports_in_window",
          "legendFormat": "reports"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Last run age",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 86400},
              {"color": "red", "value": 172800}
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "raven_eval_run_age_seconds",
          "legendFormat": "age"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Eval pass rate — 7-day trend",
      "description": "Daily pass rate vs the frozen baseline.  A widening gap is a regression signal.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "raven_eval_pass_rate",
          "legendFormat": "current"
        },
        {
          "refId": "B",
          "expr": "raven_eval_pass_rate_baseline",
          "legendFormat": "baseline"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "p95 prompt latency — 7-day trend",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "raven_eval_p95_latency_ms",
          "legendFormat": "p95 current"
        },
        {
          "refId": "B",
          "expr": "raven_eval_p95_latency_ms_baseline",
          "legendFormat": "p95 baseline"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Audit events — by risk (rate / 5m)",
      "description": "From `app/observability/metrics.py`.  Requires the RAVEN web server /metrics endpoint to be scraped.",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {"drawStyle": "bars", "fillOpacity": 60, "stacking": {"mode": "normal"}}
        }
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (risk) (rate(raven_audit_events_by_risk_total[5m]))",
          "legendFormat": "{{risk}}"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Vault rotations — cumulative",
      "description": "From `app/observability/metrics.py`.",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 12},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 0}
        }
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "raven_vault_rotations_total",
          "legendFormat": "rotations"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Per-category pass rate (current run)",
      "description": "Bar gauge of the latest eval's pass rate per EvalPrompt category.",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 12},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {"drawStyle": "bars", "fillOpacity": 70}
        }
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "raven_eval_by_category_pass_rate",
          "legendFormat": "{{category}}"
        }
      ]
    }
  ]
}
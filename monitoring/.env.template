# Environment Configuration Template
# Copy to /etc/systemd/system/anomaly-handler.service and update values

# MQTT Configuration
export FRIGATE_MQTT_HOST="localhost"
export FRIGATE_MQTT_PORT="1883"

# Frigate API Endpoints
export FRIGATE_API_URL="http://localhost:5000"
export FRIGATE_RTSP_URL="rtsp://localhost:8554"

# PostgreSQL Database - **CHANGE PASSWORD BEFORE DEPLOYMENT**
export POSTGRES_URL="postgresql://saras:CHANGE_THIS_PASSWORD@localhost:5432/saras"

# Storage Configuration
export CLIPS_DIR="/var/lib/saras/anomalies"

# Alert Configuration (optional - leave empty to disable)
export ANOMALY_WEBHOOK_URL=""
export TELEGRAM_TOKEN=""
export TELEGRAM_CHAT_ID=""

# Anomaly Detection Thresholds (seconds & confidence scores)
export LOITER_THRESHOLD="30"                    # Person loitering > 30 sec
export STATIC_OBJECT_THRESHOLD="120"            # Unattended object > 120 sec
export WEAPON_CONFIDENCE="0.5"                  # YOLO confidence threshold
export ZOOM_FACTOR="2.5"                        # Digital zoom on subject

# Web Server
export FLASK_PORT="8080"

# Logging
export LOG_LEVEL="INFO"                         # DEBUG, INFO, WARNING, ERROR

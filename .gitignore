# ═══════════════════════════════════════════════════════════════════════
# Raven — .gitignore
# ═══════════════════════════════════════════════════════════════════════

# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
wheels/
*.egg-info/
*.egg
*.whl
pip-wheel-metadata/
.eggs/

# ── Virtual environments ─────────────────────────────────────────────
.venv/
venv/
env/

# ── Environment & secrets ───────────────────────────────────────────
.env
.env.*
!.env.example
.env.local
.env.production

# ── IDE / Editor ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Logs ────────────────────────────────────────────────────────────
*.log
logs/
nohup.out

# ── Databases (runtime data) ────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# ── HelixDB ─────────────────────────────────────────────────────────
.helix/

# ── Workspace (user data — never committed) ─────────────────────────
workspace/
!workspace/SOUL.md.example

# ── Memory (runtime data) ───────────────────────────────────────────
memory/

# ── Node.js ─────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Testing ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover
.hypothesis/
.tox/
.nox/

# ── Build artifacts ─────────────────────────────────────────────────
*.tar.gz
*.zip
*.rar
*.deb
*.rpm
*.AppImage

# ── Training data (user-generated) ──────────────────────────────────
training_data/
*.jsonl

# ── Runtime state ───────────────────────────────────────────────────
checkpoints/
monitoring/*.db
monitoring/*.db-*

# ── Desktop app build ───────────────────────────────────────────────
desktop/node_modules/
desktop/dist/
desktop/target/

# ── Companion shell ─────────────────────────────────────────────────
companion-shell/node_modules/
companion-shell/dist/
companion-shell/src-tauri/target/

# ── Scripts output ──────────────────────────────────────────────────
scripts/output/

# ── Root-level scratch/test files ───────────────────────────────────
test_*.py
!tests/
*.md.bak
*.tmp
*.bak

# ── Planning/strategy docs (not for repo) ───────────────────────────
STRATEGY_100x_BETTER.md
GAP_ANALYSIS_2026_06.md
PLAN20260301.md
STATUS_2026_06.md
friday.md
newplan.md
newplan2.md
plan.md
PLAN_v3.md
analysis20260301.md

# ── Tool/planner scratch dirs ───────────────────────────────────────
tests_harness*/
.mimocode/
plans.kiro/
specs/
